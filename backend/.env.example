# Required: Primary LLM for chat and highlights
# Get your key from https://console.groq.com/
GROQ_API_KEY=

# Required: Embeddings and fallback LLM
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Required: Chroma Cloud vector database
# Get your API key and tenant ID from https://console.trychroma.com/
CHROMA_API_KEY=
TENANT_CHROMA=

# Required: Resend email service for contact/feedback form
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=
# The email address where feedback and contact messages will be delivered
CONTACT_EMAIL=


# On AWS the keys above come from SSM Parameter Store (/nexus/, put there by
# scripts/set_aws_secrets.py) and TABLE_NAME from Terraform. Locally TABLE_NAME is optional:
# without it chats aren't logged and there are no rate limits.
# TABLE_NAME=
