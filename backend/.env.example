# Required: Primary LLM for chat and highlights
# Get your key from https://console.groq.com/
GROQ_API_KEY=

# Required: Embeddings and fallback LLM
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Required: Chroma Cloud vector database
# Get your API key and tenant ID from https://console.trychroma.com/
CHROMA_API_KEY=
TENANT_CHROMA=

# Required: Supabase PostgreSQL database for chat message logging
# Get your connection string from: Project Settings → Database → Connection string (URI)
DATABASE_URL=
